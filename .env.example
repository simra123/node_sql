# Neon PostgreSQL connection string
CON_STRING=postgresql://user:password@host/database?sslmode=require

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1d

# Used only when the admins table does not already contain this email.
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-secure-password

HOST=127.0.0.1
PORT=4000

# Comma-separated frontend origins. Defaults to * when omitted.
# Example: http://localhost:5173,https://app.example.com
CORS_ORIGIN=
